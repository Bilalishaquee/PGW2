# Core
PARAGON_DB_PATH=./data/paragon_leads.db
PARAGON_TIMEZONE=America/New_York
PARAGON_MIN_FIT_SCORE=60
PARAGON_HIGH_FIT_SCORE=80

# Search providers (set one or both)
SERPAPI_KEY=
BING_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=

# Optional behavior tuning
MAX_RESULTS_PER_QUERY=10
MAX_LEADS_PER_RUN=200
REQUIRE_CONTACT_FOR_SAVE=true
REQUIRE_EMAIL_FOR_B2B=false
